{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend.starter.teamofsilicons.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://backend.starter.teamofsilicons.com/auth/:path*"
    },
    {
      "source": "/starters/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/new",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    }
  ]
}
