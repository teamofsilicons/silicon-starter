[Unit]
Description=Silicon Starter API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starter
Group=starter
WorkingDirectory=/var/lib/starter
EnvironmentFile=/etc/starter/starter-api.env
ExecStart=/opt/starter/current/starter-api
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/starter
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
